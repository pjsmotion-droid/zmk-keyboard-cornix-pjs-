#include "zmk-helpers/helper.h"
#include "includes/cornix54.h"

// tap windows for ctl alt and gui

#define HM_TAPPING_TERM 250
#define HM_TAPPING_REPEAT 210

// quick tapping for shift

#define HM_TAPPING_TERM_FAST 200
#define HM_PRIOR_IDLE 70
#define BASE 0
#define WIN 1
#define LOWER 2
#define RAISE 3
#define ADJUST 4
#define NAVI   5
#define NUM    6
#define DEBUG  7

// https://github.com/urob/zmk-config/tree/main#timeless-homerow-mods

#define KEYS_L LT0 LT1 LT2 LT3 LT4 LT5 LM0 LM1 LM2 LM3 LM4 LM5 LB0 LB1 LB2 LB3 LB4 LB5  // left hand
#define KEYS_R RT0 RT1 RT2 RT3 RT4 RT5 RM0 RM1 RM2 RM3 RM4 RM5 RB0 RB1 RB2 RB3 RB4 RB5  // right hand
#define THUMBS LH1 LH0 RH0 RH1
#define KEYS_T LH1 LH0 RH0 RH1
#define ZMK_POINTING_DEFAULT_SCRL_VAL 15

#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/ext_power.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/pointing.h>

/ {
    // Activate ADJUST layer by pressing raise and lower

    behaviors {
        hm_l: homerow_mods_left {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            bindings = <&kp>, <&kp>;

            flavor = "balanced";
            tapping-term-ms = <HM_TAPPING_TERM>;
            quick-tap-ms = <200>;                // repeat on tap-into-hold
            require-prior-idle-ms = <HM_PRIOR_IDLE>;
            hold-trigger-key-positions = <KEYS_R KEYS_T>;
            hold-trigger-on-release;
        };

        hm_r: homerow_mods_right {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            bindings = <&kp>, <&kp>;

            flavor = "balanced";
            tapping-term-ms = <HM_TAPPING_TERM>;
            quick-tap-ms = <200>;
            require-prior-idle-ms = <HM_PRIOR_IDLE>;
            hold-trigger-key-positions = <KEYS_L KEYS_T>;
            hold-trigger-on-release;
        };

        // Positional Homerow mods for shift
        // Use faster tapping term and disable some features that may
        // cause false negatives.

        hm_shift_l: hm_shift_l {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            bindings = <&kp>, <&kp>;

            //flavor = "balanced";

            flavor = "balanced";
            tapping-term-ms = <HM_TAPPING_TERM_FAST>;
            quick-tap-ms = <200>;
            require-prior-idle-ms = <HM_PRIOR_IDLE>;
            hold-trigger-key-positions = <KEYS_R KEYS_T>;
            hold-trigger-on-release;
        };

        hm_shift_r: hm_shift_r {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            bindings = <&kp>, <&kp>;

            flavor = "balanced";
            tapping-term-ms = <HM_TAPPING_TERM_FAST>;
            quick-tap-ms = <200>;
            require-prior-idle-ms = <HM_PRIOR_IDLE>;
            hold-trigger-key-positions = <KEYS_L KEYS_T>;

            // for quick tapping; shift+~

            hold-trigger-on-release;
        };

        /*
         * Non-Positional Homerow Mods
         * Used for &mm_grescm_gui behavior on left hand.
         *
         * Usage: &hm LSHFT T
         * Tap: T
         * Tap-Tap-Hold: Repeat T
         * Hold: LSHIFT
         */

        hm: homerow_mods {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            bindings = <&kp>, <&kp>;

            flavor = "balanced";
            tapping-term-ms = <HM_TAPPING_TERM>;
            quick-tap-ms = <200>;
        };

        lt: layer_tap {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            bindings = <&mo>, <&kp>;

            flavor = "hold-preferred";
            tapping-term-ms = <HM_TAPPING_TERM>;
            quick-tap-ms = <200>;
        };

        td_0: td_0 {
            compatible = "zmk,behavior-tap-dance";
            label = "TD_0";
            #binding-cells = <0>;
            bindings = <&ht CAPS RIGHT_ALT>, <&tog 3>;
        };

        ht: hold_tap {
            compatible = "zmk,behavior-hold-tap";
            label = "hold_tap";
            bindings = <&kp>, <&kp>;

            #binding-cells = <2>;
            tapping-term-ms = <200>;
        };

        td_hwp_0: td_hwp_0 {
            compatible = "zmk,behavior-tap-dance";
            label = "TD_HWP_0";
            #binding-cells = <0>;
            bindings = <&ht COMMA PERIOD>, <&kp SEMICOLON>;

            tapping-term-ms = <180>;
        };

        td_hwp_1: td_hwp_1 {
            compatible = "zmk,behavior-tap-dance";
            label = "TD_HWP_1";
            #binding-cells = <0>;
            bindings = <&hwp_mc1_01 0 0>, <&hwp_mc1_02 0 0>;
        };

        td_hwp_2: td_hwp_2 {
            compatible = "zmk,behavior-tap-dance";
            label = "TD_HWP_2";
            #binding-cells = <0>;
            bindings = <&hwp_mc2 0 0>, <&MC_8>;
        };

        td_hwp_3: td_hwp_3 {
            compatible = "zmk,behavior-tap-dance";
            label = "TD_HWP_3";
            #binding-cells = <0>;
            bindings = <&hwp_mc3 0 0>, <&MC_9>;
        };

        hwp_mc1_01: hwp_mc1_01 {
            compatible = "zmk,behavior-hold-tap";
            label = "HWP_MC1_01";
            bindings = <&MC_4>, <&MC_1>;

            #binding-cells = <2>;
            tapping-term-ms = <200>;
        };

        hwp_mc1_02: hwp_mc1_02 {
            compatible = "zmk,behavior-hold-tap";
            label = "HWP_MC1_02";
            bindings = <&MC_0>, <&MC_7>;

            #binding-cells = <2>;
            tapping-term-ms = <200>;
        };

        hwp_mc2: hwp_mc2 {
            compatible = "zmk,behavior-hold-tap";
            label = "HWP_MC2";
            bindings = <&MC_2>, <&MC_5>;

            #binding-cells = <2>;
            tapping-term-ms = <200>;
        };

        hwp_mc3: hwp_mc3 {
            compatible = "zmk,behavior-hold-tap";
            label = "HWP_MC3";
            bindings = <&MC_6>, <&MC_3>;

            #binding-cells = <2>;
            tapping-term-ms = <200>;
        };

        td_1: td_1 {
            compatible = "zmk,behavior-tap-dance";
            label = "TD_1";
            #binding-cells = <0>;
            bindings = <&ht SLASH QUESTION>, <&kp EXCLAMATION>;
        };

        hwp_uni_1: hwp_uni_1 {
            compatible = "zmk,behavior-hold-tap";
            label = "HWP_UNI_1";
            bindings = <&MC_uni_h_bullet>, <&MC_uni_h_ellipsis>;

            #binding-cells = <2>;
            tapping-term-ms = <200>;
        };

        td_hwp_4: td_hwp_4 {
            compatible = "zmk,behavior-tap-dance";
            label = "TD_HWP_4";
            #binding-cells = <0>;
            bindings = <&hwp_uni_1 0 0>, <&MC_uni_mdot>;
        };

        td_media: td_media {
            compatible = "zmk,behavior-tap-dance";
            label = "TD_MEDIA";
            #binding-cells = <0>;
            bindings = <&ht C_PP C_NEXT>, <&kp C_PREV>;
        };
    };

    conditional_layers {
        compatible = "zmk,conditional-layers";

        adjust_layer {
            if-layers = <7 6>;
            then-layer = <9>;
        };
    };

    combos {
        compatible = "zmk,combos";

        cb_L_par {
            bindings = <&kp LEFT_PARENTHESIS>;
            key-positions = <2 1>;
            layers = <0>;
        };

        cb_R_par {
            bindings = <&kp RIGHT_PARENTHESIS>;
            key-positions = <3 2>;
            layers = <0>;
        };

        cb_L_bra {
            bindings = <&kp LEFT_BRACKET>;
            key-positions = <13 14>;
        };

        cb_R_bra {
            bindings = <&kp RIGHT_BRACKET>;
            key-positions = <14 15>;
        };

        cb_hwp_del {
            bindings = <&kp DEL>;
            key-positions = <1 0>;
            layers = <3>;
        };

        cb_hwp_L_par {
            bindings = <&kp LEFT_PARENTHESIS>;
            key-positions = <1 2>;
            layers = <3>;
        };

        cb_hwp_R_par {
            bindings = <&kp RIGHT_PARENTHESIS>;
            key-positions = <2 3>;
            layers = <3>;
        };
    };

    macros {
        MC_0: MC_0 {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings =
                <&macro_press>,
                <&kp LEFT_ALT>,
                <&macro_tap>,
                <&kp N0>,
                <&macro_release>,
                <&kp LEFT_ALT>;

            label = "MC_0";
            wait-ms = <10>;
            tap-ms = <10>;
        };

        MC_1: MC_1 {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings =
                <&macro_press>,
                <&kp LEFT_ALT>,
                <&macro_tap>,
                <&kp N1>,
                <&macro_release>,
                <&kp LEFT_ALT>;

            label = "MC_1";
            wait-ms = <10>;
            tap-ms = <10>;
        };

        MC_2: MC_2 {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings =
                <&macro_press>,
                <&kp LEFT_ALT>,
                <&macro_tap>,
                <&kp N2>,
                <&macro_release>,
                <&kp LEFT_ALT>;

            label = "MC_2";
            wait-ms = <10>;
            tap-ms = <10>;
        };

        MC_3: MC_3 {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings =
                <&macro_press>,
                <&kp LEFT_ALT>,
                <&macro_tap>,
                <&kp N3>,
                <&macro_release>,
                <&kp LEFT_ALT>;

            label = "MC_3";
            wait-ms = <10>;
            tap-ms = <10>;
        };

        MC_4: MC_4 {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings =
                <&macro_press>,
                <&kp LEFT_ALT>,
                <&macro_tap>,
                <&kp N4>,
                <&macro_release>,
                <&kp LEFT_ALT>;

            label = "MC_4";
            wait-ms = <10>;
            tap-ms = <10>;
        };

        MC_5: MC_5 {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings =
                <&macro_press>,
                <&kp LEFT_ALT>,
                <&macro_tap>,
                <&kp N5>,
                <&macro_release>,
                <&kp LEFT_ALT>;

            label = "MC_5";
            wait-ms = <10>;
            tap-ms = <10>;
        };

        MC_6: MC_6 {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings =
                <&macro_press>,
                <&kp LEFT_ALT>,
                <&macro_tap>,
                <&kp N6>,
                <&macro_release>,
                <&kp LEFT_ALT>;

            label = "MC_6";
            wait-ms = <10>;
            tap-ms = <10>;
        };

        MC_7: MC_7 {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings =
                <&macro_press>,
                <&kp LEFT_ALT>,
                <&macro_tap>,
                <&kp N7>,
                <&macro_release>,
                <&kp LEFT_ALT>;

            label = "MC_7";
            wait-ms = <10>;
            tap-ms = <10>;
        };

        MC_8: MC_8 {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings =
                <&macro_press>,
                <&kp LEFT_ALT>,
                <&macro_tap>,
                <&kp N8>,
                <&macro_release>,
                <&kp LEFT_ALT>;

            label = "MC_8";
            wait-ms = <10>;
            tap-ms = <10>;
        };

        MC_9: MC_9 {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings =
                <&macro_press>,
                <&kp LEFT_ALT>,
                <&macro_tap>,
                <&kp N9>,
                <&macro_release>,
                <&kp LEFT_ALT>;

            label = "MC_9";
            wait-ms = <10>;
            tap-ms = <10>;
        };

        MC_uni_h_ellipsis: MC_uni_h_ellipsis {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings =
                <&macro_press>,
                <&kp LEFT_ALT>,
                <&macro_tap>,
                <&kp KP_NUMBER_0 &kp KP_NUMBER_1 &kp KP_NUMBER_3 &kp KP_NUMBER_3>,
                <&macro_release>,
                <&kp LEFT_ALT>;

            label = "MC_UNI_H_ELLIPSIS";
            wait-ms = <10>;
            tap-ms = <10>;
        };

        MC_uni_h_bullet: MC_uni_h_bullet {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings =
                <&macro_press>,
                <&kp LEFT_ALT>,
                <&macro_tap>,
                <&kp KP_NUMBER_0 &kp KP_NUMBER_1 &kp KP_NUMBER_4 &kp KP_NUMBER_9>,
                <&macro_release>,
                <&kp LEFT_ALT>;

            label = "MC_UNI_H_BULLET";
            wait-ms = <10>;
            tap-ms = <10>;
        };

        MC_uni_mdot: MC_uni_mdot {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings =
                <&macro_press>,
                <&kp LEFT_ALT>,
                <&macro_tap>,
                <&kp KP_NUMBER_1 &kp KP_NUMBER_8 &kp KP_NUMBER_3>,
                <&macro_release>,
                <&kp LEFT_ALT>;

            label = "MC_UNI_MDOT";
            wait-ms = <10>;
            tap-ms = <10>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        default_layer {
            display-name = "Base";

            // ------------------------------------------------------------------------------------------------------------
            // |   `   |  1  |  2  |  3   |  4   |  5   |                   |  6   |  7    |  8    |  9   |   0   |       |
            // |  ESC  |  Q  |  W  |  E   |  R   |  T   |                   |  Y   |  U    |  I    |  O   |   P   | BKSPC |
            // |  TAB  |  A  |  S  |  D   |  F   |  G   |                   |  H   |  J    |  K    |  L   |   ;   |   '   |
            // | SHIFT |  Z  |  X  |  C   |  V   |  B   |  MUTE  |  |       |  N   |  M    |  ,    |  .   |   /   | SHIFT |
            //               | GUI | ALT  | CTRL | LOWER|  ENTER |  | SPACE | RAISE| CTRL  | ALT   | GUI  |

            bindings = <
&kp TAB    &kp Q         &kp W         &kp E  &kp R  &kp T                          &kp Y      &kp U  &kp I      &kp O           &kp P           &kp BACKSPACE
&td_0      &kp A         &kp S         &kp D  &kp F  &kp G                          &kp H      &kp J  &kp K      &kp L           &kp BACKSLASH   &kp ENTER
&kp LSHFT  &kp Z         &kp X         &kp C  &kp V  &kp B      &kp K_MUTE  &tog 1  &kp N      &kp M  &kp COMMA  &kp DOT         &kp UP_ARROW    &kp SLASH
&kp LCTRL  &kp LEFT_GUI  &kp LEFT_ALT  &mo 6  &mo 7  &kp SPACE                      &kp RSHFT  &mo 5  &mo 8      &kp LEFT_ARROW  &kp DOWN_ARROW  &kp RIGHT_ARROW
            >;

            sensor-bindings = <&inc_dec_kp C_VOL_UP C_VOL_DN &inc_dec_kp PG_UP PG_DN>;
        };

        mac1_layer {
            display-name = "Base";
            bindings = <
&kp TAB    &kp Q         &kp W         &kp E  &kp R  &kp T                          &kp Y      &kp U  &kp I      &kp O           &kp P           &kp BACKSPACE
&kp CAPS   &kp A         &kp S         &kp D  &kp F  &kp G                          &kp H      &kp J  &kp K      &kp L           &kp BACKSLASH   &kp ENTER
&kp LSHFT  &kp Z         &kp X         &kp C  &kp V  &kp B      &kp K_MUTE  &tog 1  &kp N      &kp M  &kp COMMA  &kp DOT         &kp UP_ARROW    &kp SLASH
&kp LCTRL  &kp LEFT_GUI  &kp LEFT_ALT  &mo 6  &mo 7  &kp SPACE                      &kp RSHFT  &mo 5  &mo 8      &kp LEFT_ARROW  &kp DOWN_ARROW  &kp RIGHT_ARROW
            >;

            sensor-bindings =
                <&inc_dec_kp C_VOL_UP C_VOL_DN>,
                <&inc_dec_kp PG_UP PG_DN>;
        };

        mac2_layer {
            bindings = <
&kp LC(N0)  &kp LC(LEFT_BRACKET)  &kp LC(RIGHT_BRACKET)  &kp E      &kp B      &kp LC(U)                  &kp N7  &kp N8  &kp N9  &trans  &trans  &trans
&trans      &kp LC(Z)             &kp LS(LC(Z))          &kp LC(D)  &kp LC(J)  &kp LC(K)                  &kp N4  &kp N5  &kp N6  &trans  &trans  &trans
&trans      &kp LC(Z)             &kp LC(X)              &kp LC(C)  &kp LC(V)  &kp LC(B)  &trans  &tog 2  &kp N1  &kp N2  &kp N3  &trans  &trans  &trans
&trans      &trans                &trans                 &trans     &trans     &trans                     &trans  &trans  &trans  &trans  &trans  &trans
            >;

            sensor-bindings =
                <&inc_dec_kp RIGHT_BRACKET LEFT_BRACKET>,
                <&inc_dec_kp C_VOL_UP C_VOL_DN>;
        };

        hwp_layer {
            bindings = <
&kp BACKSPACE         &td_hwp_1     &td_hwp_2      &td_hwp_3  &none                 &none                               &none            &none  &none  &none           &none           &none
&td_0                 &kp SQT       &td_1          &kp MINUS  &kp TILDE             &none                               &none            &none  &none  &none           &none           &none
&mt LEFT_SHIFT ENTER  &td_hwp_0     &td_hwp_4      &none      &none                 &none                 &none  &none  &none            &none  &none  &none           &kp UP_ARROW    &kp DEL
&kp LCTRL             &kp LEFT_GUI  &kp RIGHT_ALT  &mo 7      &mt LEFT_SHIFT SPACE  &mt LEFT_SHIFT SPACE                &kp RIGHT_SHIFT  &mo 4  &mo 8  &kp LEFT_ARROW  &kp DOWN_ARROW  &kp RIGHT_ARROW
            >;

            sensor-bindings = <&inc_dec_kp C_VOL_UP C_VOL_DN>;
        };

        Navi_layer {
            display-name = "Navi";
            bindings = <
&none  &none  &none           &mmv MOVE_UP    &kp PAGE_UP      &kp PAGE_DOWN                   &mkp MB1  &mkp MB3  &mkp MB2  &msc SCRL_UP  &msc SCRL_DOWN  &none
&none  &none  &mmv MOVE_LEFT  &mmv MOVE_DOWN  &mmv MOVE_RIGHT  &msc SCRL_UP                    &kp LEFT  &kp DOWN  &kp UP    &kp RIGHT     &none           &none
&none  &none  &none           &none           &none            &msc SCRL_DOWN  &trans  &trans  &trans    &trans    &none     &none         &none           &none
&none  &none  &none           &mo 2           &trans           &trans                          &none     &none     &kp N5    &none         &none           &none
            >;
        };

        Symbol_layer {
            display-name = "Symbols";

            // TODO: Some binds are waiting for shifted keycode support.
            // -------------------------------
            // |       |  F1 |  F2 |  F3  |  F4  |  F5  |                   |  F6  |  F7   |  F8   |  F9  |  F10  |  F11  |
            // |   `   |  1  |  2  |  3   |  4   |  5   |                   |  6   |  7    |  8    |  9   |   0   |  F12  |
            // |       |  !  |  @  |  #   |  $   |  %   |                   |  ^   |  &    |  *    |  (   |   )   |   |   |
            // |       |  =  |  -  |  +   |  {   |  }   |        |  |       |  [   |  ]    |  ;    |  :   |   \   |       |
            //               |     |      |      |      |        |  |       |      |       |       |      |

            bindings = <
&none  &kp EXCL  &kp AT    &kp HASH  &kp DLLR  &kp PRCNT                  &kp CARET  &kp AMPS      &kp ASTRK  &kp LPAR   &kp RPAR  &kp PIPE
&none  &none     &kp LBKT  &kp RBKT  &kp LBRC  &kp RBRC                   &kp EQUAL  &kp UNDER     &kp MINUS  &kp PLUS   &kp DQT   &kp SQT
&none  &none     &kp RBKT  &kp RPAR  &kp PIPE  &kp BSLH   &trans  &trans  &kp FSLH   &kp QUESTION  &kp GRAVE  &kp TILDE  &kp SQT   &none
&none  &none     &none     &none     &trans    &trans                     &kp TILDE  &trans        &kp GRAVE  &none      &none     &none
            >;

            sensor-bindings = <&inc_dec_kp C_VOL_UP C_VOL_DN &inc_dec_kp PG_UP PG_DN>;
        };

        Mix_layer {
            display-name = "Mix";

            // ------------------------------------------------------------------------------------------------------------
            // | BTCLR | BT1  | BT2  |  BT3  |  BT4  |  BT5 |                |      |      |       |      |       |       |
            // |       | INS  | PSCR | GUI   |       |      |                | PGUP |      |   ^   |      |       |       |
            // |       | ALT  | CTRL | SHIFT |       | CAPS |                | PGDN |   <- |   v   |  ->  |  DEL  | BKSPC |
            // |       | UNDO | CUT  | COPY  | PASTE |      |      |  |      |      |      |       |      |       |       |
            //                |      |       |       |      |      |  |      |      |      |       |      |

            bindings = <
&kp ESCAPE  &kp F1  &kp F2     &kp F3  &kp F4   &kp F5                         &kp F6    &kp F7     &kp F8     &kp F9    &kp F10  &kp F11
&trans      &kp N5  &kp N4     &kp N3  &kp N2   &kp N1                         &kp BSPC  &kp MINUS  &kp EQUAL  &kp PLUS  &kp DQT  &kp F12
&trans      &kp N6  &kp N7     &kp N8  &kp N9   &kp N0         &trans  &trans  &kp TAB   &kp INS    &kp HOME   &kp END   &trans   &trans
&none       &none   &td_media  &trans  &kp TAB  &kp BACKSPACE                  &trans    &trans     &kp N3     &none     &none    &none
            >;

            sensor-bindings = <&inc_dec_kp C_VOL_UP C_VOL_DN &inc_dec_kp PG_UP PG_DN>;
        };

        KeyPad_layer {
            display-name = "NumPad";
            bindings = <
&kp ESCAPE  &kp TILDE  &kp N7  &kp N8  &kp N9     &kp SEMICOLON                  &none      &none    &none      &none     &none     &kp DEL
&none       &td_hwp_0  &kp N4  &kp N5  &kp N6     &kp MINUS                      &kp EQUAL  &kp SQT  &none      &none     &none     &none
&kp LSHFT   &kp N0     &kp N1  &kp N2  &kp N3     &none          &trans  &trans  &none      &none    &kp COMMA  &kp DOT   &kp UP    &kp FSLH
&kp LCTRL   &none      &kp N0  &none   &td_media  &mo 2                          &kp RSHFT  &none    &none      &kp LEFT  &kp DOWN  &kp RIGHT
            >;
        };

        Adjust_layer {
            display-name = "Adjust";

            // ----------------------------------------------------------------------------------------------------------------------------
            // | BTCLR  |  BT1    |  BT2    |   BT3   |   BT4   |   BT5   |                  |      |      |       |      |       |       |
            // | moDEBUG| RGB_HUD | RGB_HUI | RGB_SAD | RGB_SAI | RGB_EFF |                  |      |      |       |      |       |       |
            // | EXTPWR | RGB_BRD | RGB_BRI |         |         |         |                  |      |      |       |      |       |       |
            // |        |         |         |         |         |         | RGB_TOG | |      |      |      |       |      |       |       |
            //                    |         |         |         |         |         | |      |      |      |       |      |

            bindings = <
&bt BT_CLR      &bt BT_SEL 0   &bt BT_SEL 1   &bt BT_SEL 2   &bt BT_SEL 3   &bt BT_SEL 4                   &to 2  &to 3  &none  &none  &none             &none
&none           &bt BT_DISC 0  &bt BT_DISC 1  &bt BT_DISC 2  &bt BT_DISC 3  &bt BT_DISC 4                  &none  &none  &none  &none  &none             &none
&bt BT_CLR_ALL  &none          &none          &none          &none          &none          &trans  &trans  &none  &none  &none  &none  &ext_power EP_ON  &kp CAPSLOCK
&none           &none          &none          &none          &none          &none                          &none  &none  &none  &none  &none             &none
            >;
        };

        Debug_layer {
            display-name = "Debug";

            // ----------------------------------------------------------------------------------------------------------------------------
            // | BTCLR  |  BT1    |  BT2    |   BT3   |   BT4   |   BT5   |                  |      |      |       |      |       |       |
            // | EXTPWR | BTCLR | RGB_HUI | RGB_SAD | RGB_SAI | RGB_EFF |                  |      |      |       |      |       |       |
            // |        | RGB_BRD | RGB_BRI |         |         |         |                  |      |      |       |      |       |       |
            // |        |         |         |         |         |         | RGB_TOG | |      |      |      |       |      |       |       |
            //                    |         |         |         |         |         | |      |      |      |       |      |

            bindings = <
&bt BT_CLR  &bt BT_SEL 0  &bt BT_SEL 1  &bt BT_SEL 2  &bt BT_SEL 3  &bt BT_SEL 4                  &none        &none  &none   &none  &none  &none
&none       &none         &none         &none         &none         &none                         &none        &none  &none   &none  &none  &none
&none       &none         &none         &none         &none         &bootloader   &trans  &trans  &bootloader  &none  &none   &none  &none  &none
&none       &none         &none         &none         &none         &none                         &none        &none  &kp N7  &none  &none  &none
            >;
        };
    };
};
